{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "companion-bridge/v1/capabilities.schema.json",
  "title": "CompanionBridge Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "pluginVersion", "integrations"],
  "properties": {
    "contractVersion": { "const": 1 },
    "pluginVersion": { "type": "string" },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault", "mmocore", "mmoprofiles", "spark"],
      "properties": {
        "vault": { "$ref": "#/definitions/integrationFlag" },
        "mmocore": { "$ref": "#/definitions/integrationFlag" },
        "mmoprofiles": { "$ref": "#/definitions/integrationFlag" },
        "spark": { "$ref": "#/definitions/integrationFlag" }
      }
    }
  },
  "definitions": {
    "integrationFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "detail": { "type": ["string", "null"] }
      }
    }
  }
}
