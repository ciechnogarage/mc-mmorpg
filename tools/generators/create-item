#!/usr/bin/env node

const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

const DEFAULT_ROOT = path.resolve(__dirname, '../..');
const SUPPORTED_SUBJECT = 'item.weapon.sword.ashen_vanguard';
const SUPPORTED_SECTION_KEY = 'ASHEN_VANGUARD';
const SOURCE_REL = 'content/items/weapons/ashen_vanguard.yaml';
const PROJECTION_REL = 'build/runtime/items/ashen_vanguard.yml';
const TARGET_REL = 'MCMMORPG/plugins/MMOItems/item/sword.yml';
const REGISTRY_REL = 'registry/content/items/item.weapon.sword.ashen_vanguard.yaml';
const INDEX_REL = 'registry/content-registry.yaml';
const TEMPLATE_REGISTRY_REL = 'docs/production/template-registry.yaml';
const NORMALIZATION_CONTRACT_REL = 'docs/production/contracts/mmoitems-item-normalization.yaml';
const SECTION_SCHEMA_CONTRACT_REL = 'docs/production/contracts/mmoitems-item-section-schema.yaml';

const OWNED_KEYS = new Set([
  'base',
  'name',
  'lore',
  'attack-damage',
  'attack-speed',
  'required-level',
]);

function sha256(text) {
  return `sha256:${crypto.createHash('sha256').update(text, 'utf8').digest('hex')}`;
}

function ensureParent(filePath) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
}

function readTextOrEmpty(filePath) {
  if (!fs.existsSync(filePath)) return '';
  return fs.readFileSync(filePath, 'utf8');
}

function readYamlViaPython(filePath) {
  const parser = [
    'import json, sys, yaml',
    'with open(sys.argv[1], "r", encoding="utf-8") as handle:',
    '    data = yaml.safe_load(handle)',
    'print(json.dumps(data if data is not None else {}))',
  ].join('\n');
  const result = spawnSync('python3', ['-c', parser, filePath], {
    encoding: 'utf8',
    maxBuffer: 1024 * 1024,
  });
  if (result.status !== 0) {
    const detail = (result.stderr || result.stdout || '').trim();
    throw new Error(`Failed to parse YAML ${filePath}: ${detail}`);
  }
  return JSON.parse(result.stdout);
}

function quoteYamlString(value) {
  return `'${String(value).replaceAll("'", "''")}'`;
}

function buildSourceModel() {
  return {
    schema_version: 1,
    id: SUPPORTED_SUBJECT,
    display_name: 'Ashen Vanguard',
    content_type: 'item',
    item_family: 'weapon',
    item_subfamily: 'sword',
    template_id: 'item.weapon.sword',
    runtime: {
      plugin: 'MMOItems',
      target_file: TARGET_REL,
      section_key: SUPPORTED_SECTION_KEY,
    },
    stats: {
      base: 'SWORD',
      name: '&6Ashen Vanguard',
      lore: [
        '&7Forged for the vanguard that walks out of ash first.',
        '&8Pilot item generated by domain-18 content pipeline.',
      ],
      'attack-damage': 9.0,
      'attack-speed': 1.6,
      'required-level': 12,
    },
  };
}

function buildSourceContent() {
  const source = buildSourceModel();
  return [
    'schema_version: 1',
    `id: ${source.id}`,
    `display_name: ${source.display_name}`,
    `content_type: ${source.content_type}`,
    `item_family: ${source.item_family}`,
    `item_subfamily: ${source.item_subfamily}`,
    `template_id: ${source.template_id}`,
    'runtime:',
    `  plugin: ${source.runtime.plugin}`,
    `  target_file: ${source.runtime.target_file}`,
    `  section_key: ${source.runtime.section_key}`,
    'stats:',
    `  base: ${source.stats.base}`,
    `  name: ${quoteYamlString(source.stats.name)}`,
    '  lore:',
    ...source.stats.lore.map((line) => `    - ${quoteYamlString(line)}`),
    `  attack-damage: ${source.stats['attack-damage'].toFixed(1)}`,
    `  attack-speed: ${source.stats['attack-speed'].toFixed(1)}`,
    `  required-level: ${source.stats['required-level']}`,
    '',
  ].join('\n');
}

function validateSource(source) {
  const checks = [
    ['schema_version', source.schema_version === 1],
    ['id', source.id === SUPPORTED_SUBJECT],
    ['content_type', source.content_type === 'item'],
    ['item_family', source.item_family === 'weapon'],
    ['item_subfamily', source.item_subfamily === 'sword'],
    ['template_id', source.template_id === 'item.weapon.sword'],
    ['runtime.plugin', source.runtime && source.runtime.plugin === 'MMOItems'],
    ['runtime.target_file', source.runtime && source.runtime.target_file === TARGET_REL],
    ['runtime.section_key', source.runtime && source.runtime.section_key === SUPPORTED_SECTION_KEY],
    ['stats.base', source.stats && source.stats.base === 'SWORD'],
    ['stats.name', source.stats && typeof source.stats.name === 'string' && source.stats.name.length > 0],
    ['stats.lore', source.stats && Array.isArray(source.stats.lore) && source.stats.lore.length > 0 && source.stats.lore.length <= 12],
    ['stats.attack-damage', source.stats && typeof source.stats['attack-damage'] === 'number' && source.stats['attack-damage'] >= 0],
    ['stats.attack-speed', source.stats && typeof source.stats['attack-speed'] === 'number'],
    ['stats.required-level', source.stats && Number.isInteger(source.stats['required-level']) && source.stats['required-level'] >= 0],
  ];
  const failed = checks.filter(([, ok]) => !ok).map(([field]) => field);
  if (failed.length > 0) {
    throw new Error(`Source validation failed for: ${failed.join(', ')}`);
  }
}

function buildProjectionSection(source) {
  return [
    `${source.runtime.section_key}:`,
    `  base: ${source.stats.base}`,
    `  name: ${quoteYamlString(source.stats.name)}`,
    '  lore:',
    ...source.stats.lore.map((line) => `    - ${quoteYamlString(line)}`),
    `  attack-damage: ${source.stats['attack-damage'].toFixed(1)}`,
    `  attack-speed: ${source.stats['attack-speed'].toFixed(1)}`,
    `  required-level: ${source.stats['required-level']}`,
    '',
  ].join('\n');
}

function parseSectionEntries(sectionBody) {
  const lines = sectionBody.split('\n').filter((line) => line.length > 0);
  const entries = [];
  let current = null;

  for (const line of lines) {
    const keyMatch = line.match(/^  ([A-Za-z0-9_-]+):(?:\s(.*))?$/);
    if (keyMatch) {
      if (current) entries.push(current);
      current = { key: keyMatch[1], lines: [line] };
      continue;
    }
    if (current) current.lines.push(line);
  }

  if (current) entries.push(current);
  return entries;
}

function mergeSection(targetText, projectionSection) {
  const sectionRegex = new RegExp(`(^|\\n)${SUPPORTED_SECTION_KEY}:\\n([\\s\\S]*?)(?=\\n[A-Z0-9_]+:|$)`, 'm');
  const match = targetText.match(sectionRegex);

  if (!match) {
    const separator = targetText.length === 0 || targetText.endsWith('\n') ? '' : '\n';
    return {
      nextText: `${targetText}${separator}${projectionSection}`,
      committedSection: projectionSection,
      action: 'append-section',
      drift: false,
    };
  }

  const plannedEntries = parseSectionEntries(projectionSection.split('\n').slice(1).join('\n'));
  const plannedByKey = new Map(plannedEntries.map((entry) => [entry.key, entry.lines]));
  const mergedEntries = [];
  const seen = new Set();

  for (const entry of parseSectionEntries(match[2])) {
    if (OWNED_KEYS.has(entry.key) && plannedByKey.has(entry.key)) {
      mergedEntries.push(...plannedByKey.get(entry.key));
      seen.add(entry.key);
      continue;
    }
    mergedEntries.push(...entry.lines);
  }

  for (const [key, lines] of plannedByKey.entries()) {
    if (!seen.has(key)) mergedEntries.push(...lines);
  }

  const committedSection = `${SUPPORTED_SECTION_KEY}:\n${mergedEntries.join('\n')}\n`;
  const nextText = targetText.replace(sectionRegex, `${match[1]}${committedSection.trimEnd()}`);
  return {
    nextText: nextText.endsWith('\n') ? nextText : `${nextText}\n`,
    committedSection,
    action: committedSection === projectionSection ? 'no-op' : 'update-owned-keys',
    drift: committedSection !== projectionSection,
  };
}

function buildTemplateRegistry() {
  return [
    'schema_version: 1',
    'registry_id: content-template-registry',
    'template_id: item.weapon.sword',
    'content_type: item',
    'item_family: weapon',
    'item_subfamily: sword',
    'version: 1',
    'schema: schemas/items/item.schema.json',
    'template: templates/items/item.template.yaml',
    'generator: tools/generators/create-item',
    'runtime_adapter: null',
    'runtime_plugin: MMOItems',
    'runtime_targets:',
    `  file: ${TARGET_REL}`,
    "  section_key_pattern: '^[A-Z0-9_]+$'",
    '  format: mmoitems-item',
    'cardinality: one_subject_per_target',
    `allowed_normalization_contract: ${NORMALIZATION_CONTRACT_REL}`,
    `section_schema_contract: ${SECTION_SCHEMA_CONTRACT_REL}`,
    `pilot_section_key: ${SUPPORTED_SECTION_KEY}`,
    'owners:',
    '  contract: domain-05',
    '  runtime: domain-16',
    '  pipeline: domain-18',
    '  qa: domain-17',
    'pilot_subjects:',
    `  - ${SUPPORTED_SUBJECT}`,
    '',
  ].join('\n');
}

function buildRegistryRecord(digests) {
  return [
    `id: ${SUPPORTED_SUBJECT}`,
    'display_name: Ashen Vanguard',
    'content_type: item',
    `source_path: ${SOURCE_REL}`,
    'template_id: item.weapon.sword',
    'schema_version: 1',
    'template_version: 1',
    'digests:',
    `  subject_digest: ${digests.subject}`,
    `  dependency_digest: ${digests.dependency}`,
    'dependencies:',
    '  - kind: contract',
    `    id: ${NORMALIZATION_CONTRACT_REL}`,
    '    required_version: 1',
    '    policy: exact',
    '  - kind: contract',
    `    id: ${SECTION_SCHEMA_CONTRACT_REL}`,
    '    required_version: 1',
    '    policy: exact',
    'runtime_identity:',
    '  plugin: MMOItems',
    `  target_file: ${TARGET_REL}`,
    `  section_key: ${SUPPORTED_SECTION_KEY}`,
    `  target_tuple: MMOItems:${TARGET_REL}#${SUPPORTED_SECTION_KEY}`,
    `  generated_projection_digest: ${digests.projection}`,
    `  committed_target_digest: ${digests.committed}`,
    '  effective_runtime_digest: null',
    'output_manifest:',
    '  status: generated',
    '  generated_at: deterministic',
    '  generator: tools/generators/create-item',
    '  outputs:',
    '    - kind: source',
    `      path: ${SOURCE_REL}`,
    `      sha256: ${digests.subject}`,
    '    - kind: runtime_projection',
    `      path: ${PROJECTION_REL}`,
    `      sha256: ${digests.projection}`,
    `      target_ref: MMOItems:${TARGET_REL}#${SUPPORTED_SECTION_KEY}`,
    '    - kind: committed_target_section',
    `      path: ${TARGET_REL}`,
    `      sha256: ${digests.committed}`,
    `      target_ref: MMOItems:${TARGET_REL}#${SUPPORTED_SECTION_KEY}`,
    'lifecycle:',
    '  stage: draft',
    'contract_status: pending_review',
    'runtime_status: not_loaded',
    'release_status: blocked',
    'owners:',
    '  design: domain-05',
    '  pipeline: domain-18',
    '  runtime: domain-16',
    '  qa: domain-17',
    'runtime_state:',
    '  last_loaded_build: null',
    '  last_verified_build: null',
    'evidence: {}',
    'created_at: 2026-07-31T00:00:00Z',
    'updated_at: 2026-07-31T00:00:00Z',
    'deprecated: false',
    '',
  ].join('\n');
}

function buildContentRegistry() {
  return [
    'schema_version: 1',
    'registry_id: content-registry',
    'generated_from:',
    `  - ${REGISTRY_REL}`,
    'entries:',
    `  - subject_id: ${SUPPORTED_SUBJECT}`,
    `    registry_path: ${REGISTRY_REL}`,
    `    source_path: ${SOURCE_REL}`,
    '    content_type: item',
    '    template_id: item.weapon.sword',
    '    runtime_plugin: MMOItems',
    `    target_tuple: MMOItems:${TARGET_REL}#${SUPPORTED_SECTION_KEY}`,
    '    lifecycle_stage: draft',
    '    runtime_status: not_loaded',
    '',
  ].join('\n');
}

function parseArgs(argv) {
  const positionals = argv.slice(2).filter((arg) => !arg.startsWith('--'));
  return {
    subject: positionals[0] || SUPPORTED_SUBJECT,
    dryRun: argv.includes('--dry-run'),
    forceSource: argv.includes('--force-source'),
    repoRoot: process.env.MC_CONTENT_ROOT || DEFAULT_ROOT,
  };
}

function buildPlan(root, forceSource) {
  const sourcePath = path.join(root, SOURCE_REL);
  const projectionPath = path.join(root, PROJECTION_REL);
  const targetPath = path.join(root, TARGET_REL);
  const registryPath = path.join(root, REGISTRY_REL);
  const indexPath = path.join(root, INDEX_REL);
  const templateRegistryPath = path.join(root, TEMPLATE_REGISTRY_REL);

  const expectedSource = buildSourceContent();
  const currentSource = readTextOrEmpty(sourcePath);
  if (currentSource && currentSource !== expectedSource && !forceSource) {
    throw new Error('Refusing to overwrite existing source content without --force-source.');
  }

  const source = currentSource ? readYamlViaPython(sourcePath) : buildSourceModel();
  validateSource(source);

  const projection = buildProjectionSection(source);
  const mergedTarget = mergeSection(readTextOrEmpty(targetPath), projection);

  const dependencyPayload = [
    readTextOrEmpty(path.join(root, NORMALIZATION_CONTRACT_REL)),
    readTextOrEmpty(path.join(root, SECTION_SCHEMA_CONTRACT_REL)),
    buildTemplateRegistry(),
  ].join('\n---\n');

  const digests = {
    subject: sha256(expectedSource),
    dependency: sha256(dependencyPayload),
    projection: sha256(projection),
    committed: sha256(mergedTarget.committedSection),
  };

  return {
    drift: mergedTarget.drift,
    digests,
    writes: [
      { relativePath: SOURCE_REL, path: sourcePath, content: expectedSource },
      { relativePath: PROJECTION_REL, path: projectionPath, content: projection },
      { relativePath: TARGET_REL, path: targetPath, content: mergedTarget.nextText, sectionContent: mergedTarget.committedSection, action: mergedTarget.action },
      { relativePath: REGISTRY_REL, path: registryPath, content: buildRegistryRecord(digests) },
      { relativePath: INDEX_REL, path: indexPath, content: buildContentRegistry() },
      { relativePath: TEMPLATE_REGISTRY_REL, path: templateRegistryPath, content: buildTemplateRegistry() },
    ],
  };
}

function applyPlan(plan, forceSource) {
  for (const write of plan.writes) {
    if (write.relativePath === SOURCE_REL && fs.existsSync(write.path)) {
      const current = fs.readFileSync(write.path, 'utf8');
      if (current !== write.content && !forceSource) {
        throw new Error('Refusing to overwrite existing source content without --force-source.');
      }
    }
    ensureParent(write.path);
    fs.writeFileSync(write.path, write.content, 'utf8');
  }
}

function renderSummary(mode, plan) {
  return JSON.stringify({
    mode,
    subject: SUPPORTED_SUBJECT,
    drift: plan.drift,
    digests: plan.digests,
    writes: plan.writes.map((write) => ({
      path: write.relativePath,
      action: write.action || (mode === 'dry-run' ? 'replace-file' : 'write-file'),
      sha256: sha256(write.content),
      content: mode === 'dry-run' ? (write.sectionContent || write.content) : undefined,
    })),
  }, null, 2);
}

function main() {
  const args = parseArgs(process.argv);
  if (args.subject !== SUPPORTED_SUBJECT) {
    throw new Error(`Unsupported subject ${args.subject}. This pilot only supports ${SUPPORTED_SUBJECT}.`);
  }

  const plan = buildPlan(args.repoRoot, args.forceSource);
  if (args.dryRun) {
    process.stdout.write(`${renderSummary('dry-run', plan)}\n`);
    return;
  }

  applyPlan(plan, args.forceSource);
  process.stdout.write(`${renderSummary('write', plan)}\n`);
}

try {
  main();
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exitCode = 1;
}
