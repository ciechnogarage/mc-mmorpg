# Example environment for the MC RAG stack.
# Copy to .env and adjust as needed:  cp .env.example .env

# --- Repository mount -------------------------------------------------------
# Path to the MC repository root, mounted read-only into the indexer.
# Default assumes the compose file is run from rag/ (repo root is the parent).
MC_REPO_PATH=..
REPO_NAME=MC

# Polling watch catches ordinary filesystem changes; full reconciliation is
# the recovery path for missed events and classification changes.
WATCH_INTERVAL_SECONDS=2
RECONCILE_INTERVAL_SECONDS=300
MAX_FILE_BYTES=2000000

# --- Backends ---------------------------------------------------------------
# "bge" loads the real models; "mock" is deterministic and downloads nothing.
EMBEDDING_BACKEND=bge
EMBEDDING_IMAGE_TARGET=real
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=300
RECONCILE_EMBED_BATCH_CHUNKS=32

RERANKER_BACKEND=bge
RERANKER_IMAGE_TARGET=real
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8

# CPU threading — keep conservative to stay friendly on shared machines.
OMP_NUM_THREADS=4

# --- Host port mappings -----------------------------------------------------
# Compose binds every unauthenticated endpoint to 127.0.0.1 only.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
EMBEDDING_PORT=18080
RERANKER_PORT=18081
RAG_INDEXER_PORT=18082
RAG_API_PORT=18090
MCP_PORT=18091
