# Template only. Real dev scopes must be allocated in infra/leases/registry.tsv
# and rendered with infra/bin/mc-lease sync-env <scope>.
MC_ENVIRONMENT=dev
MC_SELECTOR=replace-scope
MC_LEASE_ID=dev-replace-scope
MC_LEASE_OWNER=replace-owner
MC_LEASE_PURPOSE=replace-purpose
MC_LEASE_STATUS=allocated
MC_COMPOSE_PROJECT=mc-dev-replace-scope
MC_NAMESPACE=mc-dev-replace-scope
MC_RUNTIME_PATH=runtime/dev-replace-scope
MC_LOG_PATH=runtime/dev-replace-scope/logs
MC_SECRET_PATH=runtime/dev-replace-scope/secrets/runtime.env
MC_PUBLIC_PROXY_BIND=127.0.0.1
MC_ADMIN_BIND=127.0.0.1
MC_PUBLIC_PROXY_PORT=25568
MC_DB_HOST_PORT=23318
MC_RCON_HOST_PORT=25578
MC_MARIADB_DATABASE=mc_dev_replace_scope
MC_MARIADB_USER=mc_dev_replace_scope
MC_GAME_INIT_MEMORY=1G
MC_GAME_MAX_MEMORY=2G
MC_SOURCE_PROXY_DIR=source/shared/proxy
MC_SOURCE_GAME_DIR=source/environments/dev/replace-scope
