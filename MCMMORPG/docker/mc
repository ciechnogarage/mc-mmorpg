#!/usr/bin/env bash
# Helper on-demand dla dockerowych serwerów MCMMORPG.
# mc up <world|items|hub> startuje velocity + backend
# mc down <world|items|hub> zgaś backend (velocity zostaje)
# mc stop-all zgaś wszystko (łącznie z velocity)
# mc ps status kontenerów
# mc logs <domena|velocity> podążaj za logiem
# mc rcon <domena> "<cmd>" wyślij komendę RCON do backendu
# mc stats zużycie RAM/CPU kontenerów
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"
cd "$SCRIPT_DIR"

warn_legacy() {
  cat >&2 <<'EOF'
[legacy] docker/mc nadal steruje aktywnym stackiem world|items|hub.
[legacy] Nowy standard izolowanych środowisk używa infra/bin/mcenv z interfejsem:
[legacy]   infra/bin/mcenv config staging game
[legacy]   infra/bin/mcenv config dev <scope>
EOF
}

svc(){ case "$1" in world|items|hub|minioncore|petcore) echo "srv-$1";; velocity) echo "velocity";; *) echo "zła domena: $1" >&2; exit 2;; esac; }

cmd="${1:-}"; shift || true
case "$cmd" in
  up)      warn_legacy; dom="${1:?podaj domenę}"; docker compose --profile "$dom" up -d ;;
  down)    warn_legacy; dom="${1:?podaj domenę}"; service="$(svc "$dom")"; docker compose stop "$service" ;;
  stop-all) warn_legacy; docker compose --profile world --profile items --profile hub --profile minioncore --profile petcore down ;;
  ps)      warn_legacy; docker compose --profile world --profile items --profile hub --profile minioncore --profile petcore ps ;;
  logs)    warn_legacy; dom="${1:?podaj domenę/velocity}"; service="$(svc "$dom")"; docker compose logs -f "$service" ;;
  rcon)    warn_legacy; dom="${1:?podaj domenę}"; shift; service="$(svc "$dom")"; docker exec -i "$service" rcon-cli "$@" ;;
  stats)   warn_legacy; docker stats --no-stream ;;
  *)       grep -E '^# mc ' "$SCRIPT_PATH" | sed 's/^# //'; exit 1 ;;
esac
