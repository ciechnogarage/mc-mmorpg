#!/usr/bin/env bash
set -euo pipefail

report_port() {
  local port="$1"

  echo "== Port $port =="

  if command -v ss >/dev/null 2>&1; then
    ss -H -ltnp "( sport = :$port )" 2>/dev/null || true
  fi

  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
  fi

  echo
}

report_port 25565
report_port 25566
