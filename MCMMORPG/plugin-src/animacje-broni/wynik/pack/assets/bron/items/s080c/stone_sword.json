{
 "model": {
  "type": "minecraft:condition",
  "property": "minecraft:using_item",
  "on_true": {
   "type": "minecraft:range_dispatch",
   "property": "minecraft:use_duration",
   "scale": 0.05,
   "entries": [
    {
     "threshold": 0.2,
     "model": {
      "type": "minecraft:model",
      "model": "bron:item/s080c1/stone_sword"
     }
    },
    {
     "threshold": 0.4,
     "model": {
      "type": "minecraft:model",
      "model": "bron:item/s080c2/stone_sword"
     }
    },
    {
     "threshold": 0.6,
     "model": {
      "type": "minecraft:model",
      "model": "bron:item/s080c3/stone_sword"
     }
    }
   ],
   "fallback": {
    "type": "minecraft:model",
    "model": "bron:item/s080c/stone_sword"
   }
  },
  "on_false": {
   "type": "minecraft:condition",
   "property": "minecraft:view_entity",
   "on_true": {
    "type": "minecraft:condition",
    "property": "minecraft:keybind_down",
    "keybind": "key.left",
    "on_true": {
     "type": "minecraft:model",
     "model": "bron:item/s080kl/stone_sword"
    },
    "on_false": {
     "type": "minecraft:condition",
     "property": "minecraft:keybind_down",
     "keybind": "key.right",
     "on_true": {
      "type": "minecraft:model",
      "model": "bron:item/s080kp/stone_sword"
     },
     "on_false": {
      "type": "minecraft:condition",
      "property": "minecraft:keybind_down",
      "keybind": "key.back",
      "on_true": {
       "type": "minecraft:model",
       "model": "bron:item/s080kt/stone_sword"
      },
      "on_false": {
       "type": "minecraft:model",
       "model": "bron:item/s080/stone_sword"
      }
     }
    }
   },
   "on_false": {
    "type": "minecraft:model",
    "model": "bron:item/s080/stone_sword"
   }
  }
 }
}