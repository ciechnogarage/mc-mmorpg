{
  "name": "mcmmorpg-validation",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "foundation:qa:bot": "node foundation_bot.js",
    "repo:hygiene": "node ../../scripts/repo-hygiene.mjs --audit",
    "plugins:inventory": "node ../../scripts/plugin-inventory.mjs",
    "contracts:check": "python3 ../../scripts/check-contract-registry.py",
    "repo:checks": "node ../../tests/repo-hygiene.test.mjs && node ../../tests/plugin-inventory.test.mjs && node ../../tests/contract-registry.test.mjs && node ../../scripts/repo-hygiene.mjs && node ../../scripts/plugin-inventory.mjs && python3 ../../scripts/check-contract-registry.py",
    "modelengine:check": "node check_modelengine_binding.js",
    "modelengine:clone-shell": "node clone_reference_shell.js",
    "modelengine:gate-shell": "node check_shell_provenance.js",
    "modelengine:quick-view": "node quick_view.js",
    "modelengine:webgl-view": "node webgl_render.js",
    "modelengine:check-render-discipline": "node check_render_discipline.js",
    "modelengine:mirror": "node mirror_element.js",
    "modelengine:snap": "node snap_to_reference.js",
    "modelengine:check-content-completeness": "node check_content_completeness.js",
    "modelengine:corpus-spotcheck": "node webgl_corpus_spotcheck.js",
    "modelengine:quality": "node check_modelengine_quality.js",
    "modelengine:quality:test": "node test_modelengine_quality.js",
    "modelengine:render": "node render_bbmodel_review.js",
    "modelengine:corpus": "node analyze_model_reference_corpus.js",
    "modelengine:corpus:test": "node test_model_reference_corpus.js && node test_model_design_knowledge.js",
    "modelengine:design-knowledge": "node build_model_design_knowledge.js",
    "modelengine:design-knowledge:test": "node test_model_design_knowledge.js",
    "modelengine:corpus:render": "node --expose-gc render_model_reference_corpus.js",
    "modelengine:corpus:render:test": "node test_model_reference_visual_atlas.js",
    "modelengine:corpus:sheets": "node build_model_review_sheets.js",
    "modelengine:corpus:sheets:test": "node test_model_review_sheets.js",
    "modelengine:manual-reviews:audit": "node audit_manual_model_reviews.js",
    "modelengine:manual-reviews:test": "node test_manual_model_reviews.js",
    "modelengine:runtime-review-templates": "node build_active_runtime_review_templates.js",
    "modelengine:runtime-review-templates:test": "node test_active_runtime_review_templates.js",
    "modelengine:runtime-review-drafts": "node build_active_runtime_review_drafts.js",
    "modelengine:runtime-review-drafts:test": "node test_active_runtime_review_drafts.js",
    "modelengine:runtime-reviews:test": "node test_completed_runtime_boss_reviews.js",
    "modelengine:boss-reviews": "node build_boss_review_pipeline.js && node build_active_runtime_review_templates.js && node build_active_runtime_review_drafts.js",
    "modelengine:boss-reviews:test": "node test_boss_review_pipeline.js && node test_active_runtime_review_templates.js && node test_active_runtime_review_drafts.js && node test_completed_runtime_boss_reviews.js",
    "modelengine:ecosystem": "node check_modelengine_ecosystem.js",
    "modelengine:ecosystem:test": "node test_modelengine_ecosystem.js"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "mineflayer": "^4.20.0",
    "mineflayer-gui": "^1.0.1",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "puppeteer": "^25.3.0",
    "rcon-client": "^4.2.5"
  }
}
